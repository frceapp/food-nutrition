OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_APP_NAME=NUTRIA
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
ADMIN_PHONE_NUMBERS=628123456789
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=key/firebase-service-account.json
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok
MAX_IMAGE_SIZE_MB=5
OPTIMIZE_IMAGE=true
IMAGE_MAX_DIMENSION=1024
IMAGE_JPEG_QUALITY=75
IMAGE_MAX_PIXELS=25000000
UPLOAD_DIR=uploads
LOG_LEVEL=INFO

# Hanya diperlukan saat menjalankan migrasi MySQL satu kali.
DATABASE_NAME=nutria
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
